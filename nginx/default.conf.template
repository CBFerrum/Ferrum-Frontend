# Rendered at container start (envsubst): ${FERRUM_API_URL} is the Ferrum server, e.g. http://ferrum:5150.
# ${FERRUM_OFFICE_ORIGIN}: the editor server for online editing (e.g. https://office.example.com),
# which pages may frame and post to; empty when there is none. ${FERRUM_EDITORS_URL}: the editor
# server for browser editors (e.g. https://editors.example.com), which pages may frame; empty when
# there is none. ${FERRUM_MEET_URL}: the LiveKit server of video meetings (e.g.
# wss://meet.example.com), which pages may connect to over WebSocket and HTTPS (the client checks a
# refused connection's reason there); empty when there is none. ${FERRUM_MAX_UPLOAD}: the largest
# request body passed to the API (e.g. 32m); the server holds each route to its own limit.
map $host $office_origin {
    default "${FERRUM_OFFICE_ORIGIN}";
}
map $host $editors_origin {
    default "${FERRUM_EDITORS_URL}";
}
map "${FERRUM_MEET_URL}" $meet_origin {
    "~^(wss?://[^/]+)" $1;
    default "";
}
map "${FERRUM_MEET_URL}" $meet_http_origin {
    "~^ws(s?)://([^/]+)" http$1://$2;
    default "";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_tokens off;
    client_max_body_size ${FERRUM_MAX_UPLOAD};
    root /usr/share/nginx/html;

    location = / {
        include /etc/nginx/snippets/security-headers.conf;
        return 302 /app/;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Content-hashed bundles never change.
    location /app/assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The single-page app: unknown paths under /app fall back to index.html.
    # no-cache also covers sw.js, so browsers see a new version on their next update check.
    location /app/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /app/index.html;
    }

    # nginx's MIME map may not know .webmanifest.
    location = /app/manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
    }

    # API, downloads, AI agents (MCP, OAuth and its discovery documents), calendar and contacts
    # apps (which look for /.well-known/caldav and carddav first) and realtime go to the server.
    location ~ ^/(api|files|mcp|ws|oauth|_ping|_health)(/|$)|^/\.well-known/(oauth-|caldav$|carddav$) {
        proxy_pass ${FERRUM_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
